<% layout("layouts/boilerplate") %>

<body>
  <h3 class="edit">Edit your listing</h3>
  <div class="row">
    <div class="col-8 offset-2">
      <form
        action="/listing/<%= listing._id %>?_method=PUT"
        method="POST"
        class="needs-validation"
        enctype="multipart/form-data"
        novalidate
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title:</label>
          <input
            type="text"
            name="listing[title]"
            value="<%= listing.title %>"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Title looks good</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description:</label>
          <textarea name="listing[description]" class="form-control" required>
<%= listing.description %>
          </textarea>
          <div class="invalid-feedback">write a short Description</div>
        </div>

        <div>
          Original Image URL: <br />
          <img
            src="<%= listing.image.url %>"
            style="width: 250px; height: 150px"
          />
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image:</label>
          <input type="file" name="image" class="form-control" />
          <div class="invalid-feedback">Image must be type of jpg,png,jpeg</div>
        </div>

        <div class="mb-3">
          <select name="listing[category]" class="form-select" required>
            <option value=""><%= listing.category %></option>
            <option value="Beach">Beach</option>
            <option value="Mountain">Mountain</option>
            <option value="City">City</option>
            <option value="Cabin">Cabin</option>
            <option value="Camping">Camping</option>
            <option value="Heritage">Heritage</option>
            <option value="Lake">Lake</option>
            <option value="Desert">Desert</option>
            <option value="Pet-Friendly">Pet-Friendly</option>
          </select>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price:</label>
            <input
              type="number"
              name="listing[price]"
              value="<%= listing.price %>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Price must be valid!</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country:</label>
            <input
              type="text"
              name="listing[country]"
              value="<%= listing.country %>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Country must be valid!</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location:</label>
          <input
            type="text"
            name="listing[location]"
            value="<%= listing.location %>"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Location must be valid</div>
        </div>

        <button class="btn btn-danger edit-btn">Save Changes</button>
        <br /><br />
      </form>
    </div>
  </div>
</body>
