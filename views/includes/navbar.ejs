<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid d-flex align-items-center">
    <button
      class="navbar-toggler me-2"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarMenu"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <a class="navbar-brand" href="/listing">
      <i class="fa-sharp fa-regular fa-compass"></i>
    </a>

    <a class="nav-link explore-link" href="/listing">Explore</a>

    <div class="search-container ms-3 me-auto">
      <form class="search-form" method="GET" action="/listing">
        <input
          class="search-input"
          type="search"
          name="q"
          placeholder="Search destinations"
          value="<%= typeof q !== 'undefined' ? q : '' %>"
        />
        <% if (category) { %>
        <input type="hidden" name="category" value="<%= category %>" />
        <% } %>
        <button class="search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <div class="collapse navbar-collapse justify-content-end" id="navbarMenu">
      <div class="navbar-nav text-end">
        <a class="nav-link" href="/listing/new">Add new Listings</a>
        <% if (!currUser) { %>
        <a class="nav-link" href="/signup"><b>Signup</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <% } else { %>
        <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
